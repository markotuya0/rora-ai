# Mode: true = bundled student-grades demo; false = your own database (see docs/DEMO_AND_REAL_DATA.md)
DEMO_MODE=true

# Database Configuration
# DB_URI wins over DB_PATH when set, e.g. postgresql://reader:secret@host:5432/db
DB_URI=
DB_PATH=student_grades.db

# LLM Configuration
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0
OLLAMA_BASE_URL=http://localhost:11434

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_URL=http://localhost:8000

# Security
ALLOWED_ORIGINS=*
MAX_QUERY_LENGTH=500
